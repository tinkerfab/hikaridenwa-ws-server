# このファイルを secrets/app.env としてコピーし、実際の値を設定してください。
# secrets/app.env は Git 管理対象外・Docker イメージにも含まれません。
# docker-compose.yml が secrets/app.env をコンテナに bind mount して起動時に読み込みます。

# ── SIP接続情報 (必須) ─────────────────────────────────
# 光電話ルータ(HGW)のLAN側IPアドレス
HGW_HOST=192.168.1.1

# HGWのSIPポート(通常5060)
HGW_PORT=5060

# HGW管理画面で作成した内線(多機能電話ポートの拡張内線)の番号
SIP_EXTENSION=2

# SIP認証ユーザー名(HGW管理画面で設定したもの。内線番号と同じ場合が多い)
SIP_AUTH_USER=2

# SIP認証パスワード
SIP_PASSWORD=changeme

# REGISTERの有効期限(秒)
SIP_REGISTER_EXPIRES=600

# このコンテナがSIPソケットをbindするローカルアドレス
LOCAL_BIND_IP=0.0.0.0

# 他の内線が応答しないままこの秒数が経過したら、このアプリの仮想内線を480で終了させる
RING_TIMEOUT_S=30

# ── アプリケーションサーバ ────────────────────────────
# WebSocket(/ws)のリッスンポート
HTTP_PORT=8080

# アプリログ(app.log)・SIP通信トレース(sip.log)の書き出し先。
# Docker実行時はDockerfileでENV DATA_DIR=/app/dataが設定済みのため、この値は無視されます
# (docker-compose.ymlの`./data:/app/data`が実際の永続化先です)。ローカル実行時のみ有効です。
DATA_DIR=./data
